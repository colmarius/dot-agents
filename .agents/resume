#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
required_node_version="$(tr -d '[:space:]' < "$repo_root/.nvmrc")"
expected_node_version="v${required_node_version#v}"

if ! command -v node >/dev/null 2>&1; then
    echo "Node.js is unavailable; run .agents/setup" >&2
    exit 1
fi

if [[ "$(node --version)" != "$expected_node_version" ]]; then
    echo "Node.js $expected_node_version is required; run .agents/setup" >&2
    exit 1
fi

if [[ ! -x "$repo_root/node_modules/.bin/astro" ]]; then
    echo "npm dependencies are unavailable; run .agents/setup" >&2
    exit 1
fi

if [[ ! -f "$repo_root/test/test_helper/bats-support/load.bash" || ! -f "$repo_root/test/test_helper/bats-assert/load.bash" ]]; then
    echo "Test submodules are unavailable; run .agents/setup" >&2
    exit 1
fi

echo "Ensuring Orb services are running"
cd "$repo_root"
amp orb services ensure

echo "Orb environment ready"
