---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";
import versionText from "../../../VERSION?raw";

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);
const version = versionText.trim();
const releaseTag = `v${version}`;
const title = "dot-agents — Pick up AI coding work where the last agent left off";
const description =
  "dot-agents adds AGENTS.md and a small .agents/ folder to your repo. When work needs review or another session, your agent keeps the why, decisions, and next step in one Markdown file.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f7f6f2" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="dot-agents — Pick up AI coding work where the last agent left off" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="dot-agents — Pick up AI coding work where the last agent left off" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <div class="page-shell">
      <SiteHeader />

      <main id="main-content">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <h1 id="hero-title">Pick up AI coding work <em>where the last agent left off.</em></h1>
            <p class="hero-description">
              dot-agents adds an <code>AGENTS.md</code> and a small <code>.agents/</code> folder to your repo. When work
              needs review or another session, your agent keeps the why, the decisions, and the next step in one Markdown
              file the next agent resumes from.
            </p>
            <div class="hero-actions">
              <a class="button button-primary" href="#install">Install <span aria-hidden="true">↓</span></a>
              <a class="button button-secondary" href="/docs/">How it works</a>
            </div>
            <p class="hero-note">Works with Amp, Codex, Claude Code, and any agent that reads <code>AGENTS.md</code>.</p>
          </div>
        </section>

        <section id="example" class="artifacts-section section-block" aria-labelledby="artifacts-title">
          <div class="section-heading section-heading-split">
            <div>
              <p class="eyebrow">What lands in your repo</p>
              <h2 id="artifacts-title">Plain files the next session can read.</h2>
            </div>
            <div class="section-aside">
              <p>
                A work item's <code>index.md</code> holds the current state: why, what is done and left, decisions, and
                the next step. <code>log.md</code> beside it keeps the history. Both live in git, so people review them
                like any other file.
              </p>
            </div>
          </div>

          <div class="artifact-grid">
            <div class="file-tree" role="group" aria-label="Files added by dot-agents">
              <div class="file-tree-header">
                <span>your-project/</span>
                <span>installed</span>
              </div>
              <pre><code>├── <b>AGENTS.md</b>       <span># project instructions</span>
└── <b>.agents/</b>
    ├── <b>work/</b>       <span># work items</span>
    ├── <b>research/</b>   <span># findings worth reusing</span>
    ├── <b>references/</b> <span># cloned repos (gitignored)</span>
    ├── <b>skills/</b>     <span># adapt, agent-work, research</span>
    └── <b>scripts/</b>    <span># sync updates</span></code></pre>
            </div>
            <div class="example-document">
              <div class="document-bar"><span>.agents/work/sync/retry-policy/index.md</span><span>● saved</span></div>
              <pre><code><b># Retry policy for sync workers</b>

Status: blocked

<b>## Why</b>
Sync jobs fail on transient errors; the team
must agree on one retry policy.

<b>## Summary</b>
Done: proposal.md with backoff options.
Remaining: max attempts, then implement.
Branch retry-policy at 3f2a9c1; uncommitted: none.

<b>## Decisions</b>
- Accepted: retry only idempotent jobs
  (Dana, 2026-06-20, review call).
- Proposed: 5 attempts (Dana decides).

<b>## Next Action</b>
- Dana decides max attempts.</code></pre>
            </div>
          </div>
        </section>

        <section id="install" class="install-section section-block" aria-labelledby="install-title">
          <div class="section-heading">
            <p class="eyebrow">Get started</p>
            <h2 id="install-title">Three steps.</h2>
          </div>

          <ol class="start-steps">
            <li>
              <h3>Install from your repository root</h3>
              <p>It creates <code>AGENTS.md</code> and <code>.agents/</code>. Running it again updates dot-agents and keeps your work.</p>
              <div class="terminal">
                <div class="terminal-bar">
                  <span class="terminal-label"><i></i> terminal — repo root</span>
                  <span>bash</span>
                </div>
                <div class="terminal-command">
                  <pre><code><span class="prompt" aria-hidden="true">$</span> <span id="install-command">curl -fsSL https://<wbr />raw.githubusercontent.com/colmarius/<wbr />dot-agents/main/install.sh | bash</span></code></pre>
                </div>
                <div class="terminal-hints">
                  <p><span>Read it first</span><code>curl -fsSL https://raw.githubusercontent.com/colmarius/dot-agents/main/install.sh | less</code></p>
                  <p><span>Pin {releaseTag}</span><code>curl -fsSL https://raw.githubusercontent.com/colmarius/dot-agents/{releaseTag}/install.sh | bash -s -- --ref {releaseTag}</code></p>
                </div>
              </div>
            </li>
            <li>
              <h3>Tell your agent <code>Run adapt</code></h3>
              <p>It fills <code>AGENTS.md</code> with your project's commands and conventions.</p>
            </li>
            <li>
              <h3>Ask for a work item when you need one</h3>
              <p><code>Create a work item for …</code> starts one. In a later session, <code>Continue the work item at …</code> picks it up.</p>
            </li>
          </ol>
        </section>

        <section id="when" class="when-section section-block" aria-labelledby="when-title">
          <div class="section-heading">
            <p class="eyebrow">When to use a work item</p>
            <h2 id="when-title">Most work needs no files.</h2>
          </div>

          <dl class="when-rows">
            <div>
              <dt>One conversation can finish it</dt>
              <dd>Just ask. The agent does the work, checks it, and reports. Nothing is saved.</dd>
            </div>
            <div>
              <dt>People must review it, or it continues later</dt>
              <dd>
                Ask for a work item. It can hold research or a proposal for people to decide on, and a log any session can
                resume from. When you ask to close it, what should last moves into your code and docs, and the item is
                removed.
              </dd>
            </div>
          </dl>
          <a class="text-link" href="/docs/">Read how it works <span aria-hidden="true">→</span></a>
        </section>

        <p class="companion-line">
          Want the practice behind it? <a href="https://with-agents.dev/coding/">With Agents</a> is a field guide to
          briefing coding agents, checking their work, and keeping context.
        </p>
      </main>

      <SiteFooter />
    </div>

    <script>
      import { addCopyControl } from "../scripts/copy-controls";

      const container = document.querySelector<HTMLElement>(".terminal-command");
      const command = document.querySelector<HTMLElement>("#install-command");

      if (container && command) addCopyControl(container, command, "install command");
    </script>
  </body>
</html>
