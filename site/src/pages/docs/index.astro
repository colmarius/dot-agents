---
import { getEntry, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";

const entry = await getEntry("docs", "concepts");
if (!entry) throw new Error("docs/concepts.md is missing");
const { Content } = await render(entry);
---

<DocsLayout title={entry.data.title} description={entry.data.description}>
  <article class="docs-guide">
    <header class="docs-guide-header">
      <p class="eyebrow">Docs</p>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
    </header>

    <div class="docs-prose">
      <Content />
    </div>

    <nav class="docs-reference-links" aria-label="Documentation reference">
      <a href="https://github.com/colmarius/dot-agents/blob/main/QUICKSTART.md">Quickstart <span aria-hidden="true">↗</span></a>
      <a href="https://github.com/colmarius/dot-agents/blob/main/docs/skills.md">Skills reference <span aria-hidden="true">↗</span></a>
      <a href="https://github.com/colmarius/dot-agents/blob/main/.agents/work/AGENTS.md">Work-item contract <span aria-hidden="true">↗</span></a>
      <a href="https://github.com/colmarius/dot-agents/blob/main/docs/migration-v0.6.md">Migrate to v0.6 <span aria-hidden="true">↗</span></a>
    </nav>
  </article>
</DocsLayout>
