---
import { getEntry, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";

const entry = await getEntry("docs", "concepts");
if (!entry) throw new Error("docs/concepts.md is missing");
const { Content, headings } = await render(entry);
const sections = headings.filter((heading) => heading.depth === 2);
---

<DocsLayout title={entry.data.title} description={entry.data.description}>
  <article class="docs-guide">
    <header class="docs-guide-header">
      <p class="eyebrow">Docs</p>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <nav class="docs-toc" aria-labelledby="docs-toc-label">
        <span id="docs-toc-label" class="docs-toc-label">On this page</span>
        {sections.map((section) => <a href={`#${section.slug}`}>{section.text}</a>)}
      </nav>
    </header>

    <div class="docs-prose">
      <Content />
    </div>
  </article>
</DocsLayout>
